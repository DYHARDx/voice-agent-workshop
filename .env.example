# Copy to .env  (cp .env.example .env) — every line is optional.

# Which Ollama model talks AND decides which tool to use.
# 3B is the sweet spot for a laptop; llama3.1:8b is smarter but slower.
OLLAMA_MODEL=qwen2.5:3b

# 1 = agent can act (open YouTube, ...). 0 = chat only.
TOOLS_ENABLED=1

# 1 = hide the browser window. Leave 0 so everyone can SEE the agent working.
BROWSER_HEADLESS=0
